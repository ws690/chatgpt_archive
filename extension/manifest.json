{
  "manifest_version": 3,
  "name": "NAS Chat Archive (local)",
  "version": "1.0.14",
  "description": "Best-effort visible ChatGPT text collection to your local NAS archive. Not an official OpenAI export.",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
